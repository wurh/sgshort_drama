# sgdrama 后端环境变量（占位示例，真实值填入本地 .env，勿提交）

# 运行环境：local / dev / prod
NODE_ENV=local
PORT=8730

# 数据库：本地默认 sqlite；生产用 mysql
DB_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# sgdrama 固定 schema / 库名
DB_NAME=sgdrama

# Agnes 模型接入（仅后端持有 Key，前端走 BFF）
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_API_KEY=
AGNES_TEXT_MODEL=agnes-3.0-flash
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_VIDEO_MODEL=agnes-video-2.5-flash
AGNES_TIMEOUT_MS=300000

# 视频任务轮询
VIDEO_POLL_INTERVAL_MS=1500
VIDEO_POLL_TIMEOUT_MS=180000
VIDEO_SECONDS_MIN=4
VIDEO_SECONDS_MAX=12
MAX_KEYFRAMES_PER_EPISODE=20

# ffmpeg 拼接
FFMPEG_BIN=ffmpeg

# 并发
QUEUE_CONCURRENCY=2
VIDEO_CONCURRENCY=3
IMAGE_CONCURRENCY=5
